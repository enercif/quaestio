{
	"name": "quaestio",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:start": "docker compose up -d",
		"db:remove": "bash -c 'read -p \"DB-Container und Volume wirklich löschen? [y/N] \" c && [ \"$c\" = \"y\" ] && docker compose down -v'",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "pnpx auth generate --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@eslint/compat": "latest",
		"@eslint/js": "latest",
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.24.0",
		"@svelte-put/qr": "^2.1.3",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.69.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "^26.1.0",
		"@types/nodemailer": "^8.0.1",
		"@vitest/browser-playwright": "^4.1.9",
		"@wuchale/svelte": "^0.20.5",
		"better-auth": "~1.4.21",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"mode-watcher": "^1.1.0",
		"nodemailer": "^9.0.3",
		"playwright": "^1.61.1",
		"postgres": "^3.4.9",
		"prettier": "^3.9.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"runed": "^0.37.1",
		"shadcn-svelte": "^1.3.0",
		"shiki": "^4.3.1",
		"svelte": "^5.56.4",
		"svelte-adapter-uws": "^0.5.8",
		"svelte-check": "^4.7.1",
		"svelte-realtime": "^0.5.10",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.1",
		"uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.67.0",
		"vite": "^8.1.3",
		"vitest": "^4.1.9",
		"vitest-browser-svelte": "^2.2.0",
		"ws": "^8.21.0",
		"wuchale": "^0.25.6",
		"zod": "^4.4.3"
	},
	"packageManager": "pnpm@11.16.0"
}